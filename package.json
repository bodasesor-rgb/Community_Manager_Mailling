{
  "name": "community-manager-mailling",
  "version": "0.1.0",
  "private": true,
  "description": "Microservicio de email marketing (adaptador Brevo → interfaz EmailProvider)",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probar-brevo": "tsx scripts/probar-brevo.ts",
    "probar-supresion": "tsx scripts/probar-supresion.ts",
    "probar-envio": "tsx scripts/probar-envio.ts",
    "probar-validar-email": "tsx scripts/probar-validar-email.ts",
    "sync-contactos": "tsx scripts/sync-contactos.ts",
    "probar-sync-dryrun": "tsx scripts/probar-sync-dryrun.ts",
    "panel:dev": "npm --prefix panel run dev",
    "panel:build": "npm --prefix panel run build",
    "panel:start": "npm --prefix panel run start"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
