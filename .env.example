# Brevo
BREVO_API_KEY=
BREVO_DEFAULT_LIST_IDS=

# Remitente (opcional: si falta, se usa el primer sender activo de Brevo)
REMITENTE_EMAIL=
REMITENTE_NOMBRE=Bodasesor

# Gemini — copy + imágenes
# Nota: gemini-2.0-flash e imagen-3 suelen estar retirados para cuentas nuevas
# aunque haya saldo. Defaults operativos:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Se intenta primero si Google lo habilita en tu key:
IMAGEN_MODEL=imagen-3.0-generate-002
PUBLIC_BASE_URL=https://green-cod-257443.hostingersite.com

# Kommo CRM
KOMMO_BASE_URL=
KOMMO_CLAVE_SECRETA=
KOMMO_ACCESS_TOKEN=

# Protección opcional de rutas de escritura
SERVICE_API_KEY=
