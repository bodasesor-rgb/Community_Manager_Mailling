# Brevo
BREVO_API_KEY=
BREVO_DEFAULT_LIST_IDS=

# Remitente (opcional: si falta, se usa el primer sender activo de Brevo)
REMITENTE_EMAIL=
REMITENTE_NOMBRE=Bodasesor

# Gemini — un modelo de texto + un modelo de imagen (sin cascadas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Imagen 4 Fast (predict). NO uses Nano Banana salvo fallback explícito.
IMAGEN_MODEL=imagen-4.0-fast-generate-001
# Dejar en 0/omitir. Solo si Imagen 4 falla y aceptas gastar en Nano Banana:
# GEMINI_IMAGE_FALLBACK=0
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Persistencia Hostinger (fuera del checkout git para no borrar en cada deploy)
# Default: $HOME/bodasesor-mail-data
# DATA_DIR=/home/TU_USUARIO/bodasesor-mail-data
# MEDIA_DIR=/home/TU_USUARIO/bodasesor-mail-data/media
# PUBLIC_BASE_URL=https://green-cod-257443.hostingersite.com

# Sitio Bodasesor (conocimiento para emails)
SITIO_BASE_URL=https://bodasesor.com
# Completa redes (o desde /panel/sitio)
# SITIO_INSTAGRAM=
# SITIO_FACEBOOK=
# SITIO_WHATSAPP=
# SITIO_LINKEDIN=https://www.linkedin.com/company/bodasesor
# Si el WAF bloquea bots, permite este UA o define otro:
# SITIO_USER_AGENT=BodasesorMailingBot/1.0 (+https://bodasesor.com; panel-correos)
KOMMO_SUBDOMAIN=
KOMMO_TOKEN=
# Compatibilidad con nombres anteriores
KOMMO_BASE_URL=
KOMMO_CLAVE_SECRETA=
KOMMO_ACCESS_TOKEN=

# Protección opcional de rutas de escritura
SERVICE_API_KEY=
